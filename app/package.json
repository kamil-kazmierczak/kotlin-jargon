{
  "name": "kotlin-jargon",
  "version": "1.0.0",
  "private": true,
  "description": "A curated Kotlin/JVM learning graph for experienced Java developers.",
  "scripts": {
    "dev": "node scripts/generate-content.mjs && vite",
    "build": "node scripts/generate-content.mjs && vite build",
    "preview": "vite preview",
    "test": "npm run test:content && npm run test:state && npm run test:e2e",
    "test:content": "node --test tests/content-pipeline.test.mjs",
    "test:state": "node --test tests/application-state.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "verify": "npm run verify:baseline && npm run verify:reviews && npm run verify:generation && npm run build && npm test",
    "verify:baseline": "node scripts/verify-baseline.mjs",
    "verify:reviews": "node scripts/verify-human-reviews.mjs",
    "verify:generation": "node scripts/verify-generation.mjs",
    "generate": "node scripts/generate-content.mjs",
    "generate:preview": "node scripts/generate-content.mjs --preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.45.0",
    "marked": "^18.0.12",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
