{
  "name": "kotlin-jargon",
  "version": "1.0.0",
  "description": "A curated Kotlin/JVM learning graph for experienced Java developers.",
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "preview": "npm --prefix app run preview",
    "verify": "npm run verify:examples && npm --prefix app run verify",
    "verify:examples": "./examples/gradlew -p examples --no-daemon verifyExamples",
    "test": "npm --prefix app run test:content && npm --prefix app run test:state",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamil-kazmierczak/kotlin-jargon.git"
  },
  "author": "Kamil Kazmierczak",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kamil-kazmierczak/kotlin-jargon/issues"
  },
  "homepage": "https://github.com/kamil-kazmierczak/kotlin-jargon#readme",
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
